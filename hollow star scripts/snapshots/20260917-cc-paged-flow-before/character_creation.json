  "skills": {
    "Acrobatics": {
      "ability": "DEX",
      "description": "Balance, tumbling, and moving through tight spaces. Use this to keep your footing on slippery surfaces, squeeze through narrow passages, or perform flips and dodges in combat."
    },
    "Animal Handling": {
      "ability": "WIS",
      "description": "Understand and interact with animals. Calm frightened beasts, read their body language, predict their behavior, or convince a mount to obey your commands."
    },
    "Arcana": {
      "ability": "INT",
      "description": "Knowledge of magic, spells, and magical creatures. Identify magical effects, decode magical runes, understand spell mechanics, or recall lore about arcane phenomena."
    },
    "Athletics": {
      "ability": "STR",
      "description": "Physical feats of strength and endurance. Climb surfaces, jump distances, swim through water, break objects, or push/drag heavy loads."
    },
    "Deception": {
      "ability": "CHA",
      "description": "Lie convincingly and hide your true intentions. Disguise yourself, bluff your way through situations, or create false impressions to manipulate others."
    },
    "History": {
      "ability": "INT",
      "description": "Recall historical facts and events. Remember details about past kingdoms, famous battles, legendary figures, or dead civilizations relevant to your situation."
    },
    "Insight": {
      "ability": "WIS",
      "description": "Read people's emotional states and intentions. Detect lies, sense someone's mood, understand motivations beneath their words, or gain insight into someone's character."
    },
    "Intimidation": {
      "ability": "CHA",
      "description": "Frighten or threaten others into compliance. Use force of personality, deadly confidence, or implied violence to coerce someone to your will."
    },
    "Investigation": {
      "ability": "INT",
      "description": "Search for clues and uncover hidden information. Find secret doors, examine evidence, piece together mysteries, or analyze complex mechanisms."
    },
    "Medicine": {
      "ability": "WIS",
      "description": "Diagnose and treat injuries and illnesses. Stabilize a dying person, identify poisons or diseases, perform emergency surgery, or understand the effects of wounds."
    },
    "Nature": {
      "ability": "INT",
      "description": "Identify plants, animals, and natural phenomena. Understand ecosystems, predict weather patterns, identify plants for food or medicine, or track creatures through wilderness."
    },
    "Perception": {
      "ability": "WIS",
      "description": "Notice details others miss. Spot hidden enemies, detect traps, hear conversations from a distance, or notice subtle changes in your environment."
    },
    "Performance": {
      "ability": "CHA",
      "description": "Entertain and captivate an audience. Play instruments, sing, act, dance, or give speeches that inspire emotional responses and hold attention."
    },
    "Persuasion": {
      "ability": "CHA",
      "description": "Convince others through charm and reason. Negotiate deals, gain favors, sway opinions, or inspire people with compelling arguments and genuine sincerity."
    },
    "Religion": {
      "ability": "INT",
      "description": "Knowledge of deities, religious practices, and holy relics. Identify religious symbols, recall religious lore, or understand the beliefs and customs of different faiths."
    },
    "Sleight of Hand": {
      "ability": "DEX",
      "description": "Perform precise manual manipulations without being noticed. Pickpocket items, palming objects, sleight with cards and coins, or pick locks and disarm traps."
    },
    "Stealth": {
      "ability": "DEX",
      "description": "Move silently and avoid detection. Hide in shadows, sneak past enemies, move without sound, or stay concealed in your environment."
    },
    "Survival": {
      "ability": "WIS",
      "description": "Survive in the wilderness and track prey. Navigate without maps, find food and water, predict weather, identify tracks, or camp safely in dangerous terrain."
    }
  },
